    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "dados = _items[0][\"json\"]\n\nreturn [{\n    \"json\": {\n        \"projeto\": \"Reencontra\",\n        \"execucao_id\": str(dados[\"resumo_execucao_id\"]).strip(),\n        \"gerado_em\": dados[\"resumo_gerado_em\"],\n        \"mensagem\": \"Nenhum relato recebido para processamento.\",\n        \"resumo\": {\n            \"recebidos\": 0,\n            \"aguardando_revisao\": 0,\n            \"precisam_correcao\": 0,\n            \"duplicados_removidos\": 0,\n            \"total_resultados\": 0\n        },\n        \"resultados\": []\n    }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        352
      ],
      "id": "6cfb6939-0cb8-40d4-bb50-c9946baadcdc",
      "name": "Gerar resumo do lote vazio"
    },
    {
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "758f9ae3-abb8-45a1-8ee0-3a928de7479c",
      "name": "Painel da triagem",
      "position": [
        2688,
        528
      ],
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "dados = _items[0][\"json\"]\nresumo = dados[\"resumo\"]\n\ndef linha(tipo, protocolo=\"\", caso=\"\", situacao=\"\", motivo=\"\"):\n    return {\"json\": {\n        \"Tipo\": tipo,\n        \"Protocolo\": protocolo,\n        \"Caso\": caso,\n        \"Situação\": situacao,\n        \"Detalhe\": motivo\n    }}\n\ntotais = (\n    f'{resumo[\"recebidos\"]} recebidos | '\n    f'{resumo[\"aguardando_revisao\"]} para revisão | '\n    f'{resumo[\"precisam_correcao\"]} para correção | '\n    f'{resumo[\"duplicados_removidos\"]} duplicados removidos | '\n    f'{resumo[\"total_resultados\"]} resultados'\n)\nlinhas = [linha(\n    \"Resumo\",\n    situacao=f'Execução {dados[\"execucao_id\"]}',\n    motivo=totais\n)]\n\nfor relato in dados[\"resultados\"]:\n    linhas.append(linha(\n        \"Relato\",\n        protocolo=relato.get(\"protocolo\") or \"—\",\n        caso=relato.get(\"codigo_caso\") or \"—\",\n        situacao=relato[\"status\"],\n        motivo=relato.get(\"motivo\") or \"\"\n    ))\n\nif not dados[\"resultados\"]:\n    linhas.append(linha(\"Aviso\", situacao=\"Lote vazio\",\n                        motivo=dados.get(\"mensagem\", \"Sem relatos para exibir.\")))\n\nreturn linhas"
      }
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "resultados = []\nfor item in _items:\n    relato = dict(item[\"json\"])\n    for campo in (\"protocolo\", \"codigo_caso\", \"descricao\"):\n        valor = relato.get(campo)\n        if isinstance(valor, str):\n            relato[campo] = valor.strip()\n    resultados.append({\"json\": relato})\nreturn resultados"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
